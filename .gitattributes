# Shell scripts must never pick up CRLF on a Windows checkout: bash cannot run them
# ("bad interpreter" / "$'\r': command not found"). Keep every text file LF everywhere.
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
